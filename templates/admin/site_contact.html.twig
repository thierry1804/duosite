{% extends 'admin/base.html.twig' %}

{% set day_labels = {
    1: 'Lundi',
    2: 'Mardi',
    3: 'Mercredi',
    4: 'Jeudi',
    5: 'Vendredi',
    6: 'Samedi',
    7: 'Dimanche'
} %}

{% block title %}Coordonnées du site - Administration{% endblock %}

{% block breadcrumb %}
    <li><span class="dropdown-item disabled" aria-current="page">Coordonnées du site</span></li>
{% endblock %}

{% block body %}
<div class="site-contact-page">
    {{ form_start(form, {attr: {id: 'site-contact-form'}}) }}

    <div class="page-toolbar">
        <h1>Coordonnées du site</h1>
        <button type="submit" class="btn btn-primary btn-sm">
            <i data-lucide="save" class="me-1" style="width:16px;height:16px;"></i>
            Enregistrer
        </button>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success py-2">{{ message }}</div>
    {% endfor %}

    {{ form_errors(form) }}

    <div class="site-contact-grid">
        <div class="site-contact-col">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h5 class="mb-0">Contact</h5>
                </div>
                <div class="admin-card-body">
                    <div class="mb-3">
                        {{ form_label(form.addressLines) }}
                        {{ form_widget(form.addressLines) }}
                        {{ form_help(form.addressLines) }}
                        {{ form_errors(form.addressLines) }}
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email) }}
                            {{ form_errors(form.email) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.whatsappDefaultMessage) }}
                            {{ form_widget(form.whatsappDefaultMessage) }}
                            {{ form_errors(form.whatsappDefaultMessage) }}
                        </div>
                    </div>
                    <div class="mt-3 mb-0">
                        {{ form_label(form.mapEmbedUrl) }}
                        {{ form_widget(form.mapEmbedUrl) }}
                        {{ form_errors(form.mapEmbedUrl) }}
                    </div>
                </div>
            </div>

            <div class="admin-card">
                <div class="admin-card-header">
                    <h5 class="mb-0">Téléphones</h5>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-collection-add="phones">+ Ajouter</button>
                </div>
                <div class="admin-card-body">
                    {{ form_errors(form.phones) }}
                    <div class="table-responsive">
                        <table class="site-contact-table">
                            <thead>
                                <tr>
                                    <th style="width:22%">Libellé</th>
                                    <th style="width:34%">Numéro</th>
                                    <th style="width:16%">WhatsApp</th>
                                    <th style="width:16%">Principal</th>
                                    <th style="width:12%"></th>
                                </tr>
                            </thead>
                            <tbody id="phones-collection"
                                   data-prototype="{{ form_widget(form.phones.vars.prototype)|e('html_attr') }}"
                                   data-index="{{ form.phones|length }}"
                                   data-row-type="phone">
                                {% for phoneForm in form.phones %}
                                    <tr class="collection-item">
                                        <td>
                                            {{ form_widget(phoneForm.label) }}
                                            {{ form_errors(phoneForm.label) }}
                                        </td>
                                        <td>
                                            {{ form_widget(phoneForm.number) }}
                                            {{ form_errors(phoneForm.number) }}
                                        </td>
                                        <td class="text-center">
                                            {{ form_widget(phoneForm.isWhatsapp) }}
                                        </td>
                                        <td class="text-center">
                                            {{ form_widget(phoneForm.isPrimary) }}
                                        </td>
                                        <td class="text-end">
                                            {{ form_widget(phoneForm.position) }}
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-collection-remove aria-label="Supprimer">×</button>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr class="site-contact-empty-row">
                                        <td colspan="5" class="site-contact-empty">Aucun numéro. Cliquez sur « Ajouter ».</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="site-contact-col">
            <div class="admin-card">
                <div class="admin-card-header">
                    <h5 class="mb-0">Horaires</h5>
                </div>
                <div class="admin-card-body">
                    <div class="table-responsive">
                        <table class="site-contact-table">
                            <thead>
                                <tr>
                                    <th style="width:28%">Jour</th>
                                    <th style="width:18%">Fermé</th>
                                    <th style="width:27%">Ouverture</th>
                                    <th style="width:27%">Fermeture</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for hourForm in form.openingHours %}
                                    {% set day = hourForm.dayOfWeek.vars.value %}
                                    <tr class="site-contact-hours-row {{ hourForm.isClosed.vars.checked ? 'is-closed' : '' }}">
                                        <td class="site-contact-day">
                                            {{ day_labels[day]|default('Jour '~day) }}
                                            <div class="d-none">{{ form_widget(hourForm.dayOfWeek) }}</div>
                                        </td>
                                        <td class="text-center">
                                            {{ form_widget(hourForm.isClosed) }}
                                        </td>
                                        <td class="hour-time">
                                            {{ form_widget(hourForm.openTime) }}
                                            {{ form_errors(hourForm.openTime) }}
                                        </td>
                                        <td class="hour-time">
                                            {{ form_widget(hourForm.closeTime) }}
                                            {{ form_errors(hourForm.closeTime) }}
                                            {{ form_errors(hourForm) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="admin-card">
                <div class="admin-card-header">
                    <h5 class="mb-0">Réseaux sociaux</h5>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-collection-add="social">+ Ajouter</button>
                </div>
                <div class="admin-card-body">
                    <div class="table-responsive">
                        <table class="site-contact-table">
                            <thead>
                                <tr>
                                    <th style="width:30%">Réseau</th>
                                    <th style="width:58%">URL</th>
                                    <th style="width:12%"></th>
                                </tr>
                            </thead>
                            <tbody id="social-collection"
                                   data-prototype="{{ form_widget(form.socialLinks.vars.prototype)|e('html_attr') }}"
                                   data-index="{{ form.socialLinks|length }}"
                                   data-row-type="social">
                                {% for linkForm in form.socialLinks %}
                                    <tr class="collection-item">
                                        <td>
                                            {{ form_widget(linkForm.network) }}
                                            {{ form_errors(linkForm.network) }}
                                        </td>
                                        <td>
                                            {{ form_widget(linkForm.url) }}
                                            {{ form_errors(linkForm.url) }}
                                        </td>
                                        <td class="text-end">
                                            {{ form_widget(linkForm.position) }}
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-collection-remove aria-label="Supprimer">×</button>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr class="site-contact-empty-row">
                                        <td colspan="3" class="site-contact-empty">Aucun réseau. Cliquez sur « Ajouter ».</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="site-contact-actions">
        <button type="submit" class="btn btn-primary">
            <i data-lucide="save" class="me-1" style="width:16px;height:16px;"></i>
            Enregistrer les modifications
        </button>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
<script>
(function () {
    function removeEmptyRow(collection) {
        var empty = collection.querySelector('.site-contact-empty-row');
        if (empty) empty.remove();
    }

    function wrapPhoneRow(fieldsHtml) {
        var tmp = document.createElement('div');
        tmp.innerHTML = fieldsHtml;
        var inputs = {
            label: tmp.querySelector('[name*="[label]"]'),
            number: tmp.querySelector('[name*="[number]"]'),
            wa: tmp.querySelector('[name*="[isWhatsapp]"]'),
            primary: tmp.querySelector('[name*="[isPrimary]"]'),
            position: tmp.querySelector('[name*="[position]"]')
        };
        var tr = document.createElement('tr');
        tr.className = 'collection-item';
        tr.innerHTML =
            '<td></td><td></td><td></td><td></td><td class="text-end"></td>';
        if (inputs.label) tr.cells[0].appendChild(inputs.label);
        if (inputs.number) tr.cells[1].appendChild(inputs.number);
        tr.cells[2].className = 'text-center';
        tr.cells[3].className = 'text-center';
        if (inputs.wa) tr.cells[2].appendChild(inputs.wa);
        if (inputs.primary) tr.cells[3].appendChild(inputs.primary);
        if (inputs.position) tr.cells[4].appendChild(inputs.position);
        tr.cells[4].insertAdjacentHTML('beforeend',
            '<button type="button" class="btn btn-sm btn-outline-danger" data-collection-remove aria-label="Supprimer">×</button>');
        return tr;
    }

    function wrapSocialRow(fieldsHtml) {
        var tmp = document.createElement('div');
        tmp.innerHTML = fieldsHtml;
        var network = tmp.querySelector('[name*="[network]"]');
        var url = tmp.querySelector('[name*="[url]"]');
        var position = tmp.querySelector('[name*="[position]"]');
        var tr = document.createElement('tr');
        tr.className = 'collection-item';
        tr.innerHTML = '<td></td><td></td><td class="text-end"></td>';
        if (network) tr.cells[0].appendChild(network);
        if (url) tr.cells[1].appendChild(url);
        if (position) tr.cells[2].appendChild(position);
        tr.cells[2].insertAdjacentHTML('beforeend',
            '<button type="button" class="btn btn-sm btn-outline-danger" data-collection-remove aria-label="Supprimer">×</button>');
        return tr;
    }

    function addItem(collectionId, namePrefix) {
        var collection = document.getElementById(collectionId);
        if (!collection) return;
        removeEmptyRow(collection);
        var index = parseInt(collection.dataset.index || '0', 10);
        var prototype = collection.dataset.prototype || '';
        var html = prototype
            .replace(new RegExp(namePrefix + '__name__', 'g'), namePrefix + index)
            .replace(/__name__/g, String(index));
        var row = collection.dataset.rowType === 'phone'
            ? wrapPhoneRow(html)
            : wrapSocialRow(html);
        collection.appendChild(row);
        collection.dataset.index = String(index + 1);
    }

    document.querySelectorAll('[data-collection-add]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            if (btn.getAttribute('data-collection-add') === 'phones') {
                addItem('phones-collection', 'phones');
            } else {
                addItem('social-collection', 'socialLinks');
            }
        });
    });

    document.addEventListener('click', function (e) {
        var target = e.target;
        if (target && target.matches('[data-collection-remove]')) {
            var item = target.closest('.collection-item');
            if (item) item.remove();
        }
    });

    function syncClosedRow(toggle) {
        var row = toggle.closest('.site-contact-hours-row');
        if (!row) return;
        row.classList.toggle('is-closed', toggle.checked);
    }

    document.querySelectorAll('.js-closed-toggle').forEach(function (toggle) {
        syncClosedRow(toggle);
        toggle.addEventListener('change', function () {
            syncClosedRow(toggle);
        });
    });

    if (window.lucide) {
        window.lucide.createIcons();
    }
})();
</script>
{% endblock %}
