{% extends 'admin/base.html.twig' %}

{% block title %}Créer un devis manuellement | {{ parent() }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/admin/product-proposal.css') }}">
<link rel="stylesheet" href="{{ asset('css/admin/shipping-option.css') }}">
<style>
    .wizard-steps { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
    .wizard-step-btn {
        border: 1px solid #dee2e6;
        background: #fff;
        color: #495057;
        padding: 8px 14px;
        border-radius: 8px;
        font-size: 0.9rem;
    }
    .wizard-step-btn.active { background: #212529; color: #fff; border-color: #212529; }
    .wizard-step-btn.done { border-color: #198754; color: #198754; }
    .wizard-pane { display: none; }
    .wizard-pane.active { display: block; }
    .quote-item-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
        background: #fff;
        position: relative;
    }
    .quote-item-card .remove-quote-item {
        position: absolute;
        top: 10px;
        right: 10px;
    }
    .payment-block { display: none; }
    .payment-block.visible { display: block; }
</style>
{% endblock %}

{% block breadcrumb %}
    <li><a class="dropdown-item" href="{{ path('app_quote_dashboard') }}">Gestion des devis</a></li>
    <li><span class="dropdown-item disabled" aria-current="page">Créer un devis</span></li>
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-2 mb-4">
        <a href="{{ path('app_quote_dashboard') }}" class="btn btn-outline-secondary btn-sm p-2 d-inline-flex align-items-center justify-content-center flex-shrink-0" aria-label="Retour" title="Retour">
            <i data-lucide="arrow-left" width="20" height="20" aria-hidden="true"></i>
        </a>
        <h1 class="mb-0">Créer un devis manuellement</h1>
    </div>

    <div class="wizard-steps" role="tablist">
        <button type="button" class="wizard-step-btn active" data-step="1">1. Client</button>
        <button type="button" class="wizard-step-btn" data-step="2">2. Demande</button>
        <button type="button" class="wizard-step-btn" data-step="3">3. Offre</button>
    </div>

    {{ form_start(form, { attr: { id: 'manual-quote-form', enctype: 'multipart/form-data' } }) }}
    <div id="manual-quote-users-data" class="d-none" data-users="{{ users_json|json_encode|e('html_attr') }}"></div>
    {{ form_errors(form) }}

    <div class="wizard-pane active" data-pane="1">
        <div class="admin-card mb-4">
            <div class="admin-card-header"><h5 class="mb-0">Client</h5></div>
            <div class="admin-card-body">
                <div class="mb-3">
                    {{ form_row(form.selectedUser) }}
                    <div class="form-text">Choisissez un compte existant pour préremplir, ou laissez vide et saisissez les coordonnées.</div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                    <div class="col-md-6">{{ form_row(form.lastName) }}</div>
                    <div class="col-md-6">{{ form_row(form.email) }}</div>
                    <div class="col-md-6">{{ form_row(form.phone) }}</div>
                    <div class="col-md-12">{{ form_row(form.company) }}</div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end">
            <button type="button" class="btn btn-dark" data-wizard-next="2">Suivant</button>
        </div>
    </div>

    <div class="wizard-pane" data-pane="2">
        <div class="admin-card mb-4">
            <div class="admin-card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Articles demandés</h5>
                <button type="button" class="btn btn-sm btn-outline-dark" id="add-quote-item">
                    <i data-lucide="plus" style="width:16px;height:16px;"></i> Ajouter un article
                </button>
            </div>
            <div class="admin-card-body">
                <div id="quote-items-container"
                     data-prototype="{{ form_widget(form.items.vars.prototype)|e('html_attr') }}"
                     data-index="{{ form.items|length }}">
                    {% for itemForm in form.items %}
                        <div class="quote-item-card">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-quote-item" aria-label="Supprimer">
                                <i data-lucide="trash-2" style="width:16px;height:16px;"></i>
                            </button>
                            <div class="row g-3 pe-5">
                                <div class="col-md-6">{{ form_row(itemForm.productType) }}</div>
                                <div class="col-md-3">{{ form_row(itemForm.quantity) }}</div>
                                <div class="col-md-3">{{ form_row(itemForm.budget) }}</div>
                                <div class="col-12">{{ form_row(itemForm.description) }}</div>
                                <div class="col-md-6">{{ form_row(itemForm.photoFile) }}</div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <hr class="my-4">
                {{ form_row(form.shippingMethod) }}
                {{ form_row(form.additionalInfo) }}

                <div class="payment-block mt-3 {% if form.items|length > 2 %}visible{% endif %}" id="payment-block">
                    <div class="alert alert-warning mb-3">
                        Plus de 2 articles : une référence de paiement est obligatoire. Cochez « Paiement confirmé » pour pouvoir envoyer l'offre.
                    </div>
                    {{ form_row(form.transactionReference) }}
                    {{ form_row(form.paymentConfirmed) }}
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between">
            <button type="button" class="btn btn-outline-secondary" data-wizard-prev="1">Précédent</button>
            <button type="button" class="btn btn-dark" data-wizard-next="3">Suivant</button>
        </div>
    </div>

    <div class="wizard-pane" data-pane="3">
        <div class="admin-card mb-4">
            <div class="admin-card-header"><h5 class="mb-0">Offre commerciale</h5></div>
            <div class="admin-card-body">
                <div class="row g-3">
                    <div class="col-md-6">{{ form_row(form.offerTitle) }}</div>
                    <div class="col-md-6">
                        {{ form_row(form.rmbMgaExchangeRate) }}
                        {% if rmb_rate %}
                            <div class="form-text">Taux du jour : {{ rmb_rate }}</div>
                        {% endif %}
                    </div>
                    <div class="col-12">{{ form_row(form.offerDescription) }}</div>
                </div>

                <div class="mt-4 mb-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Propositions de produits</h5>
                    <button type="button" class="btn btn-success rounded-circle p-0" id="add-product-proposal" style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;" aria-label="Ajouter une proposition">
                        <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
                    </button>
                </div>
                <div class="product-proposals-container"
                     data-prototype="{{ include('quote/_manual_product_proposal_item.html.twig', { productProposalForm: form.productProposals.vars.prototype })|e('html_attr') }}"
                     data-index="{{ form.productProposals|length }}">
                    {% if form.productProposals|length == 0 %}
                        <div class="alert alert-info proposal-empty-alert">Aucune proposition. Cliquez sur + pour en ajouter.</div>
                    {% endif %}
                    {% for productProposalForm in form.productProposals %}
                        {% include 'quote/_manual_product_proposal_item.html.twig' with { productProposalForm: productProposalForm } %}
                    {% endfor %}
                </div>

                <div class="mt-4 mb-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Options d'expédition</h5>
                    <button type="button" class="btn btn-success rounded-circle p-0" id="add-shipping-option" style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;" aria-label="Ajouter une option">
                        <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
                    </button>
                </div>
                <div class="shipping-options-container"
                     data-prototype="{{ include('quote_offer/_shipping_option_prototype.html.twig', { shippingOptionForm: form.shippingOptions.vars.prototype })|e('html_attr') }}"
                     data-index="{{ form.shippingOptions|length }}">
                    {% if form.shippingOptions|length == 0 %}
                        <div class="alert alert-info shipping-empty-alert">Aucune option. Elles seront préremplies depuis les modes d'envoi choisis si vous n'en ajoutez pas.</div>
                    {% endif %}
                    {% for shippingOptionForm in form.shippingOptions %}
                        {% include 'quote_offer/_shipping_option_prototype.html.twig' with { shippingOptionForm: shippingOptionForm } %}
                    {% endfor %}
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-between gap-2">
            <button type="button" class="btn btn-outline-secondary" data-wizard-prev="2">Précédent</button>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" name="action" value="draft" class="btn btn-outline-dark">
                    Enregistrer brouillon
                </button>
                <button type="submit" name="action" value="send" class="btn btn-dark">
                    Envoyer au client
                </button>
            </div>
        </div>
    </div>

    {{ form_widget(form._token) }}
    {{ form_end(form, { render_rest: false }) }}
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script>
(function () {
    var form = document.getElementById('manual-quote-form');
    var users = [];
    try {
        var usersEl = document.getElementById('manual-quote-users-data');
        users = JSON.parse(usersEl.getAttribute('data-users') || '[]');
    } catch (e) {
        users = [];
    }

    function goToStep(step) {
        document.querySelectorAll('.wizard-pane').forEach(function (pane) {
            pane.classList.toggle('active', pane.getAttribute('data-pane') === String(step));
        });
        document.querySelectorAll('.wizard-step-btn').forEach(function (btn) {
            var s = parseInt(btn.getAttribute('data-step'), 10);
            btn.classList.toggle('active', s === step);
            btn.classList.toggle('done', s < step);
        });
        if (step === 3) {
            refreshProposalItemChoices();
        }
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    }

    document.querySelectorAll('[data-wizard-next]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            goToStep(parseInt(btn.getAttribute('data-wizard-next'), 10));
        });
    });
    document.querySelectorAll('[data-wizard-prev]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            goToStep(parseInt(btn.getAttribute('data-wizard-prev'), 10));
        });
    });
    document.querySelectorAll('.wizard-step-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            goToStep(parseInt(btn.getAttribute('data-step'), 10));
        });
    });

    // Prefill client
    var userSelect = form.querySelector('[data-user-select]');
    if (userSelect) {
        userSelect.addEventListener('change', function () {
            var id = parseInt(userSelect.value, 10);
            var user = users.find(function (u) { return u.id === id; });
            if (!user) {
                return;
            }
            var map = {
                firstName: user.firstName || '',
                lastName: user.lastName || '',
                email: user.email || '',
                phone: user.phone || '',
                company: user.company || ''
            };
            Object.keys(map).forEach(function (key) {
                var input = form.querySelector('[data-contact-field="' + key + '"]');
                if (input) {
                    input.value = map[key];
                }
            });
        });
    }

    // Quote items collection
    var itemsContainer = document.getElementById('quote-items-container');
    var paymentBlock = document.getElementById('payment-block');

    function updatePaymentVisibility() {
        var count = itemsContainer.querySelectorAll('.quote-item-card').length;
        paymentBlock.classList.toggle('visible', count > 2);
    }

    function getItemLabels() {
        var labels = [];
        itemsContainer.querySelectorAll('.quote-item-card').forEach(function (card, index) {
            var typeSelect = card.querySelector('select[id$="_productType"]');
            var desc = card.querySelector('textarea[id$="_description"]');
            var type = typeSelect && typeSelect.value ? typeSelect.value : 'Article';
            var shortDesc = desc && desc.value ? desc.value.substring(0, 40) : '';
            labels.push('#' + (index + 1) + ' — ' + type + (shortDesc ? ' — ' + shortDesc : ''));
        });
        return labels;
    }

    function refreshProposalItemChoices() {
        var labels = getItemLabels();
        document.querySelectorAll('.product-proposal-quote-item-index').forEach(function (select) {
            var current = select.value;
            Array.from(select.options).forEach(function (opt) {
                if (opt.value === '') {
                    return;
                }
                var idx = parseInt(opt.value, 10);
                if (idx < labels.length) {
                    opt.textContent = labels[idx];
                    opt.disabled = false;
                    opt.hidden = false;
                } else {
                    opt.disabled = true;
                    opt.hidden = true;
                }
            });
            if (current !== '' && parseInt(current, 10) >= labels.length) {
                select.value = '';
            }
        });
    }

    document.getElementById('add-quote-item').addEventListener('click', function () {
        var index = parseInt(itemsContainer.getAttribute('data-index'), 10) || 0;
        var prototype = itemsContainer.getAttribute('data-prototype');
        var html = prototype.replace(/__name__/g, index);
        var wrapper = document.createElement('div');
        wrapper.className = 'quote-item-card';
        wrapper.innerHTML =
            '<button type="button" class="btn btn-sm btn-outline-danger remove-quote-item" aria-label="Supprimer">' +
            '<i data-lucide="trash-2" style="width:16px;height:16px;"></i></button>' +
            '<div class="row g-3 pe-5">' + html + '</div>';
        itemsContainer.appendChild(wrapper);
        itemsContainer.setAttribute('data-index', index + 1);
        updatePaymentVisibility();
        refreshProposalItemChoices();
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    });

    itemsContainer.addEventListener('click', function (e) {
        var btn = e.target.closest('.remove-quote-item');
        if (!btn) {
            return;
        }
        var cards = itemsContainer.querySelectorAll('.quote-item-card');
        if (cards.length <= 1) {
            return;
        }
        btn.closest('.quote-item-card').remove();
        updatePaymentVisibility();
        refreshProposalItemChoices();
    });

    itemsContainer.addEventListener('change', function (e) {
        if (e.target.matches('select[id$="_productType"], textarea[id$="_description"]')) {
            refreshProposalItemChoices();
        }
    });
    itemsContainer.addEventListener('input', function (e) {
        if (e.target.matches('textarea[id$="_description"]')) {
            refreshProposalItemChoices();
        }
    });

    // Product proposals
    var $proposals = $('.product-proposals-container');
    var proposalIndex = parseInt($proposals.data('index'), 10) || 0;

    function addProductProposal() {
        var prototype = $proposals.attr('data-prototype');
        var newForm = prototype.replace(/__name__/g, proposalIndex);
        $proposals.find('.proposal-empty-alert').remove();
        $proposals.append(newForm);
        proposalIndex++;
        $proposals.data('index', proposalIndex);
        $proposals.attr('data-index', proposalIndex);
        refreshProposalItemChoices();
        initManualProposalImages($proposals[0]);
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    }

    $('#add-product-proposal').on('click', function (e) {
        e.preventDefault();
        addProductProposal();
    });

    $(document).on('click', '.remove-product-proposal', function () {
        $(this).closest('.product-proposal-item').remove();
        if ($('.product-proposal-item', $proposals).length === 0) {
            $proposals.append('<div class="alert alert-info proposal-empty-alert">Aucune proposition. Cliquez sur + pour en ajouter.</div>');
        }
    });

    function initManualProposalImages(root) {
        (root || document).querySelectorAll('.product-proposal-file-input').forEach(function (input) {
            if (input.dataset.bound === '1') {
                return;
            }
            input.dataset.bound = '1';
            input.addEventListener('change', function () {
                var container = input.closest('.product-proposal-dropzone');
                var previewBox = container ? container.querySelector('.image-upload-container') : null;
                if (!previewBox) {
                    return;
                }
                previewBox.querySelectorAll('.image-preview.temp').forEach(function (el) { el.remove(); });
                Array.from(input.files || []).forEach(function (file) {
                    if (!file.type.startsWith('image/')) {
                        return;
                    }
                    var reader = new FileReader();
                    reader.onload = function (ev) {
                        var preview = document.createElement('div');
                        preview.className = 'image-preview temp';
                        preview.innerHTML = '<img src="' + ev.target.result + '" alt=""><button type="button" class="remove-image"><i data-lucide="x" style="width:16px;height:16px;"></i></button>';
                        previewBox.appendChild(preview);
                        if (typeof lucide !== 'undefined') {
                            lucide.createIcons();
                        }
                        preview.querySelector('.remove-image').addEventListener('click', function () {
                            preview.remove();
                        });
                    };
                    reader.readAsDataURL(file);
                });
            });
        });
    }
    initManualProposalImages(document);

    // Shipping options
    var shippingContainer = document.querySelector('.shipping-options-container');
    var shippingIndex = parseInt(shippingContainer.dataset.index, 10) || 0;

    document.getElementById('add-shipping-option').addEventListener('click', function (e) {
        e.preventDefault();
        if (shippingContainer.querySelectorAll('.shipping-option-item').length >= 3) {
            return;
        }
        var prototype = shippingContainer.dataset.prototype.replace(/__name__/g, shippingIndex);
        var emptyAlert = shippingContainer.querySelector('.shipping-empty-alert');
        if (emptyAlert) {
            emptyAlert.remove();
        }
        shippingContainer.insertAdjacentHTML('beforeend', prototype);
        shippingIndex += 1;
        shippingContainer.dataset.index = String(shippingIndex);
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    });

    document.addEventListener('click', function (e) {
        var removeBtn = e.target.closest('.remove-shipping-option');
        if (!removeBtn || !shippingContainer.contains(removeBtn)) {
            return;
        }
        e.preventDefault();
        var item = removeBtn.closest('.shipping-option-item');
        if (item) {
            item.remove();
        }
        if (shippingContainer.querySelectorAll('.shipping-option-item').length === 0) {
            shippingContainer.innerHTML =
                '<div class="alert alert-info shipping-empty-alert">Aucune option. Elles seront préremplies depuis les modes d\'envoi choisis si vous n\'en ajoutez pas.</div>';
        }
    });

    updatePaymentVisibility();
    refreshProposalItemChoices();
})();
</script>
{% endblock %}
