{% extends 'base.html.twig' %}

{% block title %}Demande de devis - Duo Import MDG{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.css" crossorigin="anonymous">
<style>
    .loader-container {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(255, 255, 255, 0.8);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    .loader {
        border: 5px solid #f3f3f3;
        border-radius: 50%;
        border-top: 5px solid #0d6efd;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .loader-text {
        margin-top: 20px;
        font-size: 1.2em;
        color: #0d6efd;
    }

    /* Make validation errors visible */
    .invalid-feedback {
        display: block;
    }

    .quote-page-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }
    .quote-page-heading h1 { margin: 0; }
    .quote-page-tour-btn {
        border-color: var(--primary-color, #2b4eff);
        color: var(--primary-color, #2b4eff);
        font-weight: 600;
        border-radius: 8px;
    }
    .quote-page-tour-btn:hover {
        background: var(--primary-color, #2b4eff);
        border-color: var(--primary-color, #2b4eff);
        color: #fff;
    }
    .driver-popover.driver-popover-quote {
        font-family: 'Poppins', 'Poppins Fallback', sans-serif;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
        max-width: min(380px, calc(100vw - 32px));
    }
    .driver-popover.driver-popover-quote .driver-popover-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1a1a1a;
        letter-spacing: -0.02em;
    }
    .driver-popover.driver-popover-quote .driver-popover-description {
        font-size: 0.9375rem;
        color: #444444;
        line-height: 1.55;
    }
    .driver-popover.driver-popover-quote footer.driver-popover-footer,
    .driver-popover.driver-popover-quote .driver-popover-footer {
        background: #fff !important;
        color: #444444 !important;
        padding: 0.75rem 0 0 !important;
        margin-top: 0.75rem !important;
        border-top: 1px solid #e5e7eb;
        gap: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }
    .driver-popover.driver-popover-quote .driver-popover-progress-text {
        font-size: 0.8125rem;
        color: #6b7280;
        font-weight: 500;
    }
    .driver-popover.driver-popover-quote .driver-popover-navigation-btns { gap: 0.5rem; }
    .driver-popover.driver-popover-quote .driver-popover-next-btn {
        background: var(--primary-color, #2b4eff) !important;
        border: 1px solid var(--primary-color, #2b4eff) !important;
        color: #fff !important;
        font-weight: 600;
        font-size: 0.875rem;
        padding: 0.45rem 1rem;
        border-radius: 8px;
        text-shadow: none;
    }
    .driver-popover.driver-popover-quote .driver-popover-next-btn:hover {
        background: var(--primary-dark, #1a3dff) !important;
        border-color: var(--primary-dark, #1a3dff) !important;
        color: #fff !important;
    }
    .driver-popover.driver-popover-quote .driver-popover-prev-btn {
        background: #fff !important;
        border: 1px solid #d1d5db !important;
        color: #444444 !important;
        font-weight: 500;
        font-size: 0.875rem;
        padding: 0.45rem 1rem;
        border-radius: 8px;
        text-shadow: none;
    }
    .driver-popover.driver-popover-quote .driver-popover-prev-btn:hover {
        background: #f9fafb !important;
        border-color: #9ca3af !important;
        color: #1a1a1a !important;
    }
    .driver-popover.driver-popover-quote .driver-popover-close-btn {
        color: #6b7280 !important;
        border-radius: 6px;
        opacity: 1;
    }
    .driver-popover.driver-popover-quote .driver-popover-close-btn:hover {
        color: #1a1a1a !important;
        background: #f3f4f6 !important;
    }

    /* ---- Demande de devis : mise en page "panier" ---- */
    .quote-cart-layout {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        align-items: flex-start;
    }

    .quote-cart-main {
        flex: 1 1 560px;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .quote-cart-main-title {
        margin: 0 0 6px;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: #222;
    }

    .quote-cart-main-sub {
        margin: 0;
        color: #6c757d;
        font-size: 15px;
        line-height: 1.5;
        max-width: 560px;
    }

    .quote-items-wrapper {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 14px;
    }

    .quote-item {
        position: relative;
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #dee2e6;
        display: flex;
        flex-direction: column;
    }

    .photo-upload-container {
        position: relative;
        aspect-ratio: 4 / 3;
        background: repeating-linear-gradient(135deg, #f8f9fa 0 8px, #eef0f3 8px 16px);
    }

    .photo-upload-container .upload-label {
        position: absolute;
        inset: 0;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 4px;
        text-align: center;
        color: #6c757d;
        margin: 0;
        padding: 10px;
    }

    .photo-upload-icon {
        font-size: 26px;
        color: #6c757d;
    }

    .photo-upload-container .upload-label span {
        font-size: 12px;
        line-height: 1.3;
    }

    .photo-upload-container .upload-label small {
        font-size: 10px;
    }

    .product-photo-preview {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .quote-item-tag {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 2;
        font-size: 11px;
        font-weight: 700;
        padding: 4px 9px;
        border-radius: 999px;
        background: #e6f6ec;
        color: #198754;
    }

    .quote-item-tag.is-paid {
        background: var(--primary-color, #2b4eff);
        color: #fff;
    }

    .remove-item {
        position: absolute;
        top: 8px;
        right: 8px;
        z-index: 2;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: none;
        background: rgba(20, 24, 22, .75);
        color: #fff;
        cursor: pointer;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .quote-item-body {
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .quote-item-body .form-select,
    .quote-item-body .form-control {
        border-radius: 10px;
        font-size: 14px;
        padding: 10px;
    }

    .quote-item-row2 {
        display: flex;
        gap: 8px;
    }

    .quote-item-row2 > div {
        flex: 1;
        min-width: 0;
    }

    .quote-item-row2 .input-group {
        flex-wrap: nowrap;
    }

    .quote-item-row2 .input-group .form-control {
        border-radius: 0 10px 10px 0;
        min-width: 0;
    }

    .quote-item-row2 .input-group-text {
        border-radius: 10px 0 0 10px;
        font-size: 12px;
        padding: 10px 6px;
    }

    .quote-item-add {
        min-height: 220px;
        border-radius: 16px;
        border: 2px dashed #adb5bd;
        background: transparent;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: #222;
        width: 100%;
    }

    .quote-item-add-icon {
        font-size: 28px;
        line-height: 1;
    }

    .quote-item-add-label {
        font-weight: 700;
        font-size: 15px;
    }

    .quote-item-add-hint {
        font-family: 'Poppins', sans-serif;
        font-size: 12px;
        color: #198754;
    }

    .quote-item-add-hint.is-paid {
        color: #6c757d;
    }

    /* Sidebar */
    .quote-cart-sidebar {
        flex: 1 1 340px;
        max-width: 100%;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-radius: 18px;
        border: 1px solid #dee2e6;
        overflow: hidden;
        position: sticky;
        top: 16px;
    }

    .quote-cart-block {
        padding: 18px 20px;
        border-bottom: 1px dashed #ced4da;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .quote-cart-sidebar > .quote-cart-block:last-child {
        border-bottom: none;
    }

    .quote-cart-block-title {
        font-weight: 700;
        font-size: 14px;
    }

    .quote-cart-recap-eyebrow {
        font-family: 'Poppins', sans-serif;
        font-size: 11px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #6c757d;
        margin-bottom: 2px;
    }

    .quote-recap-line {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 14px;
    }

    .quote-recap-line-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .quote-recap-line-price {
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        color: #222;
        flex: none;
    }

    .quote-recap-line-price.is-free {
        color: #198754;
    }

    .quote-recap-total {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-top: 6px;
        padding-top: 12px;
        border-top: 1px solid #eef0ee;
    }

    .quote-recap-total span:first-child {
        font-weight: 700;
    }

    .quote-recap-total span:last-child {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .quote-shipping-options {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .quote-shipping-options .form-check {
        margin: 0;
        padding: 0;
        min-height: 0;
        height: 0;
        overflow: visible;
    }

    .quote-shipping-options .radio-card-content {
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 8px;
        padding: 8px 12px;
        text-align: left;
    }

    .quote-shipping-options .shipping-icon {
        font-size: 16px;
        margin-bottom: 0;
        flex: none;
    }

    .quote-shipping-options .radio-card-label {
        flex: 1;
        font-weight: 600;
        font-size: 14px;
    }

    .quote-shipping-delay {
        font-family: 'Poppins', sans-serif;
        font-size: 12px;
        color: #6c757d;
        flex: none;
    }

    .quote-cart-note {
        font-size: 12px;
        color: #6c757d;
        line-height: 1.45;
        margin: 0;
    }

    .quote-cart-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .quote-cart-block .form-control,
    .quote-cart-block .form-select {
        border-radius: 10px;
        font-size: 14px;
        padding: 11px;
    }

    .quote-cart-payment-box {
        background: #eef1ff;
        border-radius: 12px;
        padding: 12px;
        font-size: 13px;
        line-height: 1.5;
    }

    .quote-cart-payment-box input {
        margin-top: 8px;
        width: 100%;
        border-radius: 10px;
        border: 1px solid #ced4da;
        padding: 10px;
        font-size: 14px;
        font-family: 'Poppins', sans-serif;
        background: #fff;
    }

    .quote-cart-payment.d-none {
        display: none;
    }

    .quote-cart-checkbox {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 13px;
        cursor: pointer;
        margin: 0;
    }

    .quote-cart-checkbox input {
        margin-top: 2px;
    }

    .quote-cart-submit-btn {
        padding: 15px;
        border-radius: 12px;
        border: none;
        background: var(--primary-color, #2b4eff);
        color: #fff;
        cursor: pointer;
        font-weight: 600;
        font-size: 15px;
        box-shadow: 0 6px 16px rgba(43, 78, 255, .25);
        width: 100%;
    }
    .quote-cart-submit-btn:hover {
        background: var(--primary-dark, #1a3dff);
    }
    .quote-cart-submit-btn:disabled {
        opacity: .7;
        cursor: not-allowed;
    }

    .quote-cart-footer-note {
        margin: 0;
        font-size: 12px;
        color: #6c757d;
        text-align: center;
    }
</style>
{% endblock %}

{% block body %}
{% if app_quote_order_suspended %}
<div class="container py-5">
    {% for label, messages in app.flashes %}
        {% if label == 'success' or label == 'error' or label == 'warning' %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endif %}
    {% endfor %}
    {% include '_service_suspended_notice.html.twig' %}
</div>
{% else %}
{% set freeLimit = freeItemsLimit|default(2) %}
{% set priceAr = itemPrice|default(0) %}
{% set itemCount = form.items|length %}
{% set extraCount = itemCount > freeLimit ? (itemCount - freeLimit) : 0 %}
{% set totalAr = extraCount * priceAr %}
<div class="container py-5">
    <div class="quote-page-heading">
        <h1>Demande de devis</h1>
        <button type="button" class="btn btn-outline-primary btn-sm quote-page-tour-btn" id="quotePageTourBtn">Guide du formulaire</button>
    </div>

    <p class="mb-4">
        Veuillez remplir ce formulaire avec les détails de votre projet.
    </p>

    {% for label, messages in app.flashes %}
        {% if label == 'success' or label == 'error' or label == 'warning' %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endif %}
    {% endfor %}

    {% if form.vars.submitted and not form.vars.valid %}
    <div class="alert alert-warning mb-4">
        <p class="mb-2"><strong>Champs obligatoires pour chaque produit :</strong></p>
        <ul class="mb-0">
            <li>Le type de produit</li>
            <li>La description du produit</li>
            <li>La quantité</li>
        </ul>
    </div>
    {% endif %}

    <!-- Loader -->
    <div id="loader" class="loader-container" style="display: none;">
        <div class="loader"></div>
        <p class="loader-text">Envoi de votre demande en cours...</p>
    </div>

    {{ form_start(form, {'attr': {
        'class': 'needs-validation',
        'id': 'quoteForm',
        'novalidate': 'novalidate',
        'data-free-items-limit': freeLimit,
        'data-item-price': priceAr
    }}) }}
        {{ form_errors(form) }}

        <div class="quote-cart-layout">
            <div class="quote-cart-main">
                <div id="tour-quote-products-block" class="d-flex flex-column gap-3">
                    <div>
                        <h2 class="quote-cart-main-title">Qu'est-ce qu'on vous importe ?</h2>
                        <p class="quote-cart-main-sub">Ajoutez vos articles comme dans un panier. Le coût de la demande s'affiche à droite en temps réel. Vous ne payez qu'à partir du {{ freeLimit + 1 }}e article.</p>
                    </div>

                    <div class="alert alert-info mb-0">
                        <p class="mb-1">
                            <i class="fas fa-info-circle me-1"></i>
                            Vous ne savez pas encore quel produit choisir ? Allez faire un tour sur
                            <a href="https://www.1688.com/" target="_blank" rel="noopener noreferrer">1688.com</a>,
                            <a href="https://pinduoduo.com/" target="_blank" rel="noopener noreferrer">pinduoduo.com</a>
                            et/ou <a href="https://www.taobao.com/" target="_blank" rel="noopener noreferrer">taobao.com</a>
                            pour voir leurs produits.
                        </p>
                        <p class="mb-0">
                            Une fois vos produits repérés, collez simplement leurs liens dans la description de chaque article ci-dessous.
                        </p>
                    </div>

                    <div class="quote-items-wrapper"
                         data-prototype="{{ form_widget(form.items.vars.prototype)|e('html_attr') }}"
                         data-index="{{ form.items|length > 0 ? form.items|last.vars.name + 1 : 0 }}">

                        {% for itemForm in form.items %}
                            {% set idx = loop.index0 %}
                            <div class="quote-item">
                                <div class="photo-upload-container">
                                    <span class="quote-item-tag {{ idx < freeLimit ? '' : 'is-paid' }}">{{ idx < freeLimit ? 'Gratuit' : ('+' ~ priceAr|number_format(0, ',', ' ') ~ ' Ar') }}</span>
                                    <label for="{{ itemForm.photoFile.vars.id }}" class="upload-label">
                                        <div class="photo-upload-icon">
                                            <i class="fas fa-camera"></i>
                                        </div>
                                        <span>Ajouter une photo<br><small>(obligatoire)</small></span>
                                    </label>
                                    {{ form_widget(itemForm.photoFile, {'attr': itemForm.photoFile.vars.attr|merge({'class': 'form-control-file d-none', 'required': 'required'})}) }}
                                    <img src="#" class="product-photo-preview" alt="Aperçu de la photo">
                                    <button type="button" class="remove-item" aria-label="Retirer l'article"><i class="fas fa-times"></i></button>
                                </div>
                                {{ form_errors(itemForm.photoFile) }}

                                <div class="quote-item-body">
                                    {{ form_widget(itemForm.productType, {'attr': itemForm.productType.vars.attr|merge({'class': 'form-select product-type-select'})}) }}
                                    {{ form_errors(itemForm.productType) }}
                                    <div class="quote-item-row2">
                                        <div>
                                            {{ form_widget(itemForm.quantity, {'attr': itemForm.quantity.vars.attr|merge({'class': 'form-control quote-item-qty', 'min': 1, 'placeholder': 'Qté'})}) }}
                                        </div>
                                        <div>
                                            {{ form_widget(itemForm.budget, {'attr': itemForm.budget.vars.attr|merge({'class': 'form-control quote-item-budget', 'min': 0, 'placeholder': 'Budget'})}) }}
                                        </div>
                                    </div>
                                    {{ form_errors(itemForm.quantity) }}
                                    {{ form_errors(itemForm.budget) }}
                                    {{ form_widget(itemForm.description, {'attr': itemForm.description.vars.attr|merge({'class': 'form-control quote-item-description', 'rows': 2, 'placeholder': 'Description + lien 1688 / Taobao / Pinduoduo'})}) }}
                                    {{ form_errors(itemForm.description) }}
                                </div>
                            </div>
                        {% endfor %}

                        <button
                            type="button"
                            class="quote-item-add"
                            id="quote-add-item-btn"
                            data-free-items-limit="{{ freeLimit }}"
                        >
                            <span class="quote-item-add-icon"><i class="fas fa-plus-circle"></i></span>
                            <span class="quote-item-add-label">Ajouter un article</span>
                            <span class="quote-item-add-hint {{ itemCount < freeLimit ? '' : 'is-paid' }}" id="quoteAddHint">{{ itemCount < freeLimit ? 'gratuit' : ('+' ~ priceAr|number_format(0, ',', ' ') ~ ' Ar') }}</span>
                        </button>
                    </div>
                </div>
            </div>

            <aside class="quote-cart-sidebar">
                <div class="quote-cart-block quote-cart-recap">
                    <div class="quote-cart-recap-eyebrow">Récapitulatif</div>
                    <div id="quoteRecapLines" class="d-flex flex-column gap-2">
                        {% for itemForm in form.items %}
                            {% set idx = loop.index0 %}
                            {% set typeVal = itemForm.productType.vars.value %}
                            {% set qtyVal = itemForm.quantity.vars.value %}
                            <div class="quote-recap-line">
                                <span class="quote-recap-line-label">{{ loop.index }}. {{ typeVal ?: 'Article sans type' }}{{ qtyVal ? ' × ' ~ qtyVal : '' }}</span>
                                <span class="quote-recap-line-price {{ idx < freeLimit ? 'is-free' : '' }}">{{ idx < freeLimit ? 'gratuit' : (priceAr|number_format(0, ',', ' ') ~ ' Ar') }}</span>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="quote-recap-total">
                        <span>Frais de demande</span>
                        <span id="quoteRecapTotal">{{ totalAr > 0 ? (totalAr|number_format(0, ',', ' ') ~ ' Ar') : 'Gratuit' }}</span>
                    </div>
                </div>

                <div class="quote-cart-block" id="tour-quote-shipping">
                    <div class="quote-cart-block-title">Envoi <span class="fw-normal text-muted">(un ou plusieurs)</span></div>
                    <div style="display: none;">
                        {{ form_row(form.services) }}
                    </div>
                    <div class="quote-shipping-options">
                        {% for choice in form.shippingMethod %}
                            <label class="radio-card">
                                {{ form_widget(choice, {'attr': {'class': 'radio-card-input'}, 'label': false}) }}
                                <span class="radio-card-content">
                                    <i class="fas shipping-icon
                                        {%- if choice.vars.value == 'maritime' %} fa-ship
                                        {%- elseif choice.vars.value == 'aerien_express' %} fa-plane-departure
                                        {%- elseif choice.vars.value == 'aerien_normal' %} fa-plane
                                        {%- endif %}"></i>
                                    <span class="radio-card-label">{{ choice.vars.label }}</span>
                                    <span class="quote-shipping-delay">
                                        {%- if choice.vars.value == 'maritime' %}50–70 j
                                        {%- elseif choice.vars.value == 'aerien_express' %}3–5 j
                                        {%- elseif choice.vars.value == 'aerien_normal' %}10–20 j
                                        {%- endif %}
                                    </span>
                                </span>
                            </label>
                        {% endfor %}
                    </div>
                    {{ form_errors(form.shippingMethod) }}
                    <p class="quote-cart-note">Sourcing, négociation fournisseurs, transport, dédouanement et livraison inclus. Départs aériens hebdomadaires.</p>
                </div>

                <div class="quote-cart-block" id="tour-quote-coordinates">
                    <div class="quote-cart-block-title">Vos coordonnées</div>
                    <div class="quote-cart-grid-2">
                        {{ form_widget(form.firstName, {'attr': form.firstName.vars.attr|merge({'class': 'form-control', 'placeholder': 'Prénom'})}) }}
                        {{ form_widget(form.lastName, {'attr': form.lastName.vars.attr|merge({'class': 'form-control', 'placeholder': 'Nom'})}) }}
                    </div>
                    {{ form_errors(form.firstName) }}
                    {{ form_errors(form.lastName) }}
                    {{ form_widget(form.email, {'attr': form.email.vars.attr|merge({'class': 'form-control', 'placeholder': 'Email'})}) }}
                    {{ form_errors(form.email) }}
                    {{ form_widget(form.phone, {'attr': form.phone.vars.attr|merge({'class': 'form-control', 'placeholder': 'Téléphone'})}) }}
                    {{ form_errors(form.phone) }}
                    {{ form_widget(form.company, {'attr': form.company.vars.attr|merge({'class': 'form-control', 'placeholder': 'Entreprise (optionnel)'})}) }}
                    {{ form_widget(form.referralSource, {'attr': form.referralSource.vars.attr|merge({'class': 'form-select'})}) }}
                    {{ form_errors(form.referralSource) }}

                    <div id="tour-quote-additional">
                        {{ form_widget(form.additionalInfo, {'attr': form.additionalInfo.vars.attr|merge({'class': 'form-control', 'rows': 2, 'placeholder': 'Informations complémentaires (optionnel)'})}) }}
                        {{ form_errors(form.additionalInfo) }}
                    </div>

                    <div class="quote-cart-payment {{ extraCount > 0 ? '' : 'd-none' }}" id="quoteInlinePayment">
                        <div class="quote-cart-payment-box">
                            <p class="mb-0">Réglez <strong id="quoteInlinePaymentTotal">{{ totalAr|number_format(0, ',', ' ') }} Ar</strong> par Mobile Money au <strong>{{ primaryContactPhone }}</strong> (frais de retrait à votre charge), puis indiquez la référence. Le devis sera traité 24 à 72 h après confirmation du paiement.</p>
                            <input type="text" id="quotePaymentReferenceInput" placeholder="Référence de paiement (ex: TXN-123456)" value="{{ form.transactionReference.vars.value }}">
                            <div id="quotePaymentReferenceError" class="text-danger small mt-2 d-none">Veuillez renseigner la référence de paiement.</div>
                        </div>
                    </div>

                    <label class="quote-cart-checkbox" for="{{ form.privacyPolicy.vars.id }}" id="tour-quote-privacy">
                        {{ form_widget(form.privacyPolicy, {'attr': {'class': 'form-check-input'}}) }}
                        <span>J'accepte la <a href="{{ path('app_privacy_policy') }}" target="_blank">politique de confidentialité</a></span>
                    </label>
                    {{ form_errors(form.privacyPolicy) }}

                    <div id="tour-quote-submit" class="d-flex flex-column gap-2">
                        <button type="submit" class="quote-cart-submit-btn" id="submitButton">{{ extraCount > 0 ? ('Envoyer ma demande · ' ~ totalAr|number_format(0, ',', ' ') ~ ' Ar') : 'Envoyer ma demande · gratuit' }}</button>
                        <p class="quote-cart-footer-note">
                            Réponse sous 24 à 72 h
                            {% if site_contact.whatsappUrl %}
                                · <a href="{{ site_contact.whatsappUrl }}" target="_blank" rel="noopener noreferrer">Une question ? WhatsApp</a>
                            {% endif %}
                        </p>
                    </div>
                </div>
            </aside>
        </div>
    {{ form_end(form) }}
</div>
{% endif %}
{% endblock %}

{% block javascripts %}
{{ parent() }}
{% if not app_quote_order_suspended %}
<script src="https://cdn.jsdelivr.net/npm/driver.js@1.3.1/dist/driver.js.iife.js" crossorigin="anonymous"></script>
<script src="{{ asset('js/quote.js') }}" defer></script>
<script>
(function() {
    function getDriverFactory() {
        if (typeof window.driver !== "undefined" && window.driver && window.driver.js && window.driver.js.driver) {
            return window.driver.js.driver;
        }
        return null;
    }
    function buildQuoteTourSteps() {
        return [
            {
                popover: {
                    title: "Demande de devis",
                    description: "Ce guide présente les sections du formulaire : les produits, le mode d'envoi, vos coordonnées et l'envoi de la demande.",
                    side: "over",
                    align: "center"
                }
            },
            {
                element: "#tour-quote-products-block",
                popover: {
                    title: "Produits",
                    description: "Pour chaque article : photo obligatoire, type, quantité, budget et description. Le récapitulatif à droite se met à jour en temps réel.",
                    side: "bottom"
                }
            },
            {
                element: "#quote-add-item-btn",
                popover: {
                    title: "Plusieurs produits",
                    description: "Utilisez ce bouton pour ajouter un article supplémentaire à votre demande.",
                    side: "bottom"
                }
            },
            {
                element: "#tour-quote-shipping",
                popover: {
                    title: "Choix de l'envoi",
                    description: "Sélectionnez un ou plusieurs modes d'expédition (maritime ou aérien). Les délais indiqués sont donnés à titre indicatif.",
                    side: "left"
                }
            },
            {
                element: "#tour-quote-coordinates",
                popover: {
                    title: "Vos coordonnées",
                    description: "Indiquez votre identité et vos moyens de contact pour que notre équipe puisse vous recontacter.",
                    side: "left"
                }
            },
            {
                element: "#tour-quote-privacy",
                popover: {
                    title: "Confidentialité",
                    description: "Vous devez accepter la politique de confidentialité pour envoyer votre demande.",
                    side: "top"
                }
            },
            {
                element: "#tour-quote-submit",
                popover: {
                    title: "Envoyer",
                    description: "Après validation, notre équipe vous recontacte sous 24 à 72 h avec un devis personnalisé.",
                    side: "top"
                }
            }
        ];
    }
    var quoteTourLock = false;
    function startQuoteTour() {
        if (quoteTourLock) {
            return;
        }
        var driverFn = getDriverFactory();
        if (!driverFn) {
            return;
        }
        quoteTourLock = true;
        var tour = driverFn({
            showProgress: true,
            smoothScroll: true,
            allowClose: true,
            overlayOpacity: 0.5,
            overlayColor: "#1a1a1a",
            stageRadius: 8,
            stagePadding: 8,
            popoverClass: "driver-popover-quote",
            nextBtnText: "Suivant",
            prevBtnText: "Précédent",
            doneBtnText: "Terminer",
            progressText: "{{ '{{' }}current{{ '}}' }} / {{ '{{' }}total{{ '}}' }}",
            steps: buildQuoteTourSteps(),
            onDestroyed: function() {
                quoteTourLock = false;
                try {
                    localStorage.setItem("duoimport_quote_tour_seen", "1");
                } catch (err) {}
            }
        });
        tour.drive(0);
    }
    function quoteTourReady() {
        var btn = document.getElementById("quotePageTourBtn");
        if (btn) {
            btn.addEventListener("click", function() {
                startQuoteTour();
            });
        }
        try {
            if (!localStorage.getItem("duoimport_quote_tour_seen")) {
                setTimeout(function() {
                    if (!localStorage.getItem("duoimport_quote_tour_seen")) {
                        startQuoteTour();
                    }
                }, 500);
            }
        } catch (err) {}
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", quoteTourReady);
    } else {
        quoteTourReady();
    }
})();
</script>
{% endif %}
{% endblock %}
