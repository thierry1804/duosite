{% extends 'base.html.twig' %}

{% block title %}{{ legalPage.title }} - Duo Import MDG{% endblock %}

{% block body %}
<div class="container py-5">
    <h1 class="mb-4">{{ legalPage.title }}</h1>

    <div class="mb-4">
        <p>Dernière mise à jour : {{ legalPage.updatedAt|date('d/m/Y') }}</p>
    </div>

    <div class="privacy-web-content">
        {% if legalPage.content %}
            {{ legalPage.content|raw }}
        {% else %}
            <p>Le contenu de la politique de confidentialité n'est pas encore disponible.</p>
        {% endif %}
    </div>
</div>
<style>
    .privacy-web-content section { margin-bottom: 1.5rem; }
    .privacy-web-content h2 { font-size: 1.35rem; margin-bottom: 0.75rem; }
</style>
{% endblock %}
