{% extends 'base.html.twig' %}

{% block title %}Vérification - {{ parent() }}{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0 fs-4">Vérification</h2>
                </div>
                <div class="card-body p-4">
                    {% for message in app.flashes('danger') %}
                        <div class="alert alert-danger">{{ message }}</div>
                    {% endfor %}
                    {% for message in app.flashes('info') %}
                        <div class="alert alert-info">{{ message }}</div>
                    {% endfor %}
                    {% for message in app.flashes('warning') %}
                        <div class="alert alert-warning">{{ message }}</div>
                    {% endfor %}

                    <p class="mb-3">Saisissez le code à 6 chiffres reçu par email.</p>

                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.otpCode) }}
                            {{ form_widget(form.otpCode, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.otpCode) }}
                        </div>
                        <div class="d-grid gap-2 mb-2">
                            <button class="btn btn-primary" type="submit">Valider</button>
                        </div>
                        <div class="d-grid gap-2">
                            <button class="btn btn-link" type="submit" name="resend" value="1" formnovalidate>Renvoyer le code</button>
                        </div>
                    {{ form_end(form) }}
                </div>
                <div class="card-footer text-center">
                    <p class="mb-0"><a href="{{ path('app_forgot_password') }}">Recommencer</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
