{#
  Usage:
    {% include '_password_field_assets.html.twig' with { generate: true } %}
    {% include '_password_field_assets.html.twig' %}  {# toggle only #}
#}
<link rel="stylesheet" href="{{ asset('css/password-field.css') }}">
<script src="{{ asset('js/password-field.js') }}" defer></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        if (window.PasswordField) {
            PasswordField.enhance(document.body, { generate: {{ generate|default(false) ? 'true' : 'false' }} });
        }
    });
</script>
