{% extends 'base.html.twig' %}

{% block title %}Répondre à l'offre - Devis {{ quote.quoteNumber }} - {{ parent() }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .offer-card {
            border: 2px solid #e9ecef;
            border-radius: 15px;
            transition: all 0.3s ease;
        }
        .offer-card:hover {
            border-color: #0d6efd;
            box-shadow: 0 4px 15px rgba(13, 110, 253, 0.1);
        }
        .action-buttons {
            position: sticky;
            bottom: 0;
            background: white;
            border-top: 1px solid #e9ecef;
            padding: 20px;
            margin: 0 -20px -20px -20px;
            z-index: 30;
        }
        .offer-recap {
            position: sticky;
            top: 16px;
            align-self: flex-start;
            z-index: 20;
        }
        .offer-products {
            display: flex;
            flex-direction: column;
        }
        .offer-total-mobile {
            display: none;
            order: -1;
        }
        @media (max-width: 767.98px) {
            .offer-recap {
                position: static;
            }
            .offer-total-mobile {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                gap: 12px;
                position: sticky;
                top: 0;
                z-index: 20;
                margin: 0 0 16px;
                padding: 12px 0;
                background: #fff;
                border-bottom: 1px solid #e9ecef;
            }
        }
        .status-badge {
            font-size: 0.9em;
            padding: 8px 16px;
        }
        .offer-line {
            display: flex;
            flex-direction: column;
            gap: 16px;
            container-type: inline-size;
        }
        .offer-line-main {
            display: grid;
            grid-template-columns: 72px minmax(0, 1fr);
            gap: 12px;
            align-items: start;
        }
        .offer-line-visual {
            width: 72px;
            height: 72px;
            border-radius: 8px;
            background: #f8f9fa;
            overflow: hidden;
        }
        .offer-line-visual img {
            width: 72px;
            height: 72px;
            object-fit: contain;
        }
        .offer-line-title {
            display: flex;
            align-items: flex-start;
            gap: 8px;
        }
        .offer-line-title .form-check-input {
            margin: 3px 0 0;
            flex: 0 0 auto;
            width: 1.15rem;
            height: 1.15rem;
        }
        .offer-line-title label {
            flex: 1;
            min-width: 0;
        }
        .offer-line-name {
            font-weight: 600;
            line-height: 1.3;
            color: #212529;
        }
        .offer-line-category {
            margin: 4px 0 0 1.65rem;
            font-size: 0.8125rem;
            color: #495057;
        }
        .offer-line-details {
            margin: 8px 0 0 1.65rem;
        }
        .offer-line-details summary {
            cursor: pointer;
            font-size: 0.875rem;
            color: #0d6efd;
        }
        .offer-line-details p {
            margin: 8px 0 0;
            font-size: 0.875rem;
            line-height: 1.45;
            color: #212529;
        }
        .offer-line-source {
            display: block;
            max-width: 100%;
            margin: 8px 0 0 1.65rem;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-size: 0.875rem;
        }
        .offer-line-figures {
            display: grid;
            grid-template-columns: 6.5rem minmax(0, 1fr) minmax(0, 1fr);
            gap: 8px 16px;
            align-items: end;
            padding-top: 12px;
            border-top: 1px solid #e9ecef;
        }
        .offer-line-qty {
            width: 100%;
            max-width: 6.5rem;
        }
        .offer-line-figure-label {
            display: block;
            margin-bottom: 4px;
            font-size: 0.75rem;
            color: #495057;
        }
        .offer-line-figure-value {
            display: block;
            font-variant-numeric: tabular-nums;
            font-weight: 600;
            white-space: nowrap;
            color: #212529;
        }
        .offer-line-amount {
            color: #0d6efd;
        }
        @media (max-width: 575.98px) {
            .offer-line-main {
                grid-template-columns: 56px minmax(0, 1fr);
            }
            .offer-line-visual,
            .offer-line-visual img {
                width: 56px;
                height: 56px;
            }
        }
        @container (max-width: 420px) {
            .offer-line-figures {
                grid-template-columns: 1fr 1fr;
            }
            .offer-line-qty-field {
                grid-column: 1 / -1;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- En-tête -->
            <div class="text-center mb-4">
                <h1 class="display-6 fw-bold text-primary mb-3">
                    <i class="fas fa-handshake me-3"></i>
                    Répondre à votre offre
                </h1>
                <p class="lead text-muted">
                    Devis <strong>{{ quote.quoteNumber }}</strong> - {{ quote.createdAt|date('d/m/Y') }}
                </p>
                <div class="d-flex justify-content-center align-items-center gap-3">
                    <span class="badge bg-warning status-badge">
                        <i class="fas fa-clock me-2"></i>
                        En attente de votre réponse
                    </span>
                    <a href="{{ path('app_tracking_show', {'token': trackingToken}) }}" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-eye me-2"></i>
                        Voir le suivi complet
                    </a>
                </div>
            </div>

            <!-- Informations du devis -->
            <div class="card offer-card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle text-primary me-2"></i>
                        Informations du devis
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Client :</strong> {{ quote.fullName }}</p>
                            <p><strong>Email :</strong> {{ quote.email }}</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Téléphone :</strong> {{ quote.phone }}</p>
                            {% if quote.company %}
                                <p><strong>Entreprise :</strong> {{ quote.company }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Détails de l'offre -->
            <div class="card offer-card mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-file-invoice text-primary me-2"></i>
                        Détails de l'offre
                    </h5>
                </div>
                <div class="card-body">
                    {% if offer %}
                        <div class="row">
                            <div class="col-md-8 offer-products">
                                <h6 class="text-primary">{{ offer.title }}</h6>
                                {% if offer.description %}
                                    <p class="text-muted">{{ offer.description }}</p>
                                {% endif %}
                                
                                <!-- Produits proposés -->
                                {% set totalRmb = 0 %}
                                {% set totalMga = 0 %}
                                {% if offer.productProposals|length > 0 %}
                                    <h6 class="mt-4 mb-3">
                                        <i class="fas fa-box me-2"></i>
                                        Produits proposés
                                    </h6>
                                    {% for proposal in offer.productProposals %}
                                        {% set quantity = proposal.quoteItem.quantity ?: 1 %}
                                        {% set unitRmb = proposal.maxPrice is not null ? proposal.maxPrice : proposal.minPrice %}
                                        {% set category = proposal.quoteItem.otherProductType ?: proposal.quoteItem.productType %}
                                        {% set rawDescription = proposal.quoteItem.description|default('') %}
                                        {% set descriptionBody = rawDescription %}
                                        {% set productUrl = null %}
                                        {% if 'https://' in rawDescription or 'http://' in rawDescription %}
                                            {% set urlMarker = 'https://' in rawDescription ? 'https://' : 'http://' %}
                                            {% set urlChunks = rawDescription|split(urlMarker) %}
                                            {% set descriptionBody = urlChunks|first|trim %}
                                            {% set urlTail = urlMarker ~ (urlChunks[1]|default('')) %}
                                            {% set productUrl = urlTail|split(' ')|first %}
                                            {% set afterUrl = urlTail|replace({(productUrl): ''})|trim %}
                                            {% if afterUrl %}
                                                {% set descriptionBody = (descriptionBody ~ ' ' ~ afterUrl)|trim %}
                                            {% endif %}
                                        {% endif %}
                                        {% set productName = descriptionBody != '' ? descriptionBody : category %}
                                        {% if ' - ' in descriptionBody %}
                                            {% set nameParts = descriptionBody|split(' - ', 2) %}
                                            {% set productName = nameParts|first|trim %}
                                            {% set descriptionBody = nameParts[1]|default('')|trim %}
                                        {% else %}
                                            {% set descriptionBody = '' %}
                                        {% endif %}
                                        {% if unitRmb is not null %}
                                            {% set totalRmb = totalRmb + (unitRmb * quantity) %}
                                        {% endif %}
                                        {% set unitMga = (unitRmb is not null and offer.rmbMgaExchangeRate) ? unitRmb * offer.rmbMgaExchangeRate : null %}
                                        {% set lineMga = unitMga is not null ? (unitMga * quantity)|round : null %}
                                        {% if lineMga is not null %}
                                            {% set totalMga = totalMga + lineMga %}
                                        {% endif %}
                                        <div class="border rounded p-3 mb-3 offer-line" data-unit-rmb="{{ unitRmb }}" data-rate="{{ offer.rmbMgaExchangeRate }}">
                                            <div class="offer-line-main">
                                                <div class="offer-line-visual">
                                                    {% if proposal.images|length > 0 %}
                                                        <img src="{{ asset('uploads/product_proposals/' ~ proposal.images[0]) }}" alt="">
                                                    {% endif %}
                                                </div>
                                                <div class="offer-line-copy">
                                                    <div class="offer-line-title">
                                                        <input class="form-check-input offer-line-selected" type="checkbox" value="1" checked
                                                               id="line-selected-{{ proposal.id }}"
                                                               name="lines[{{ proposal.id }}][selected]"
                                                               form="accept-offer-form">
                                                        <label for="line-selected-{{ proposal.id }}">
                                                            <span class="offer-line-name">{{ productName }}</span>
                                                        </label>
                                                    </div>
                                                    {% if category and category != productName %}
                                                        <p class="offer-line-category">{{ category }}</p>
                                                    {% endif %}
                                                    {% if descriptionBody %}
                                                        <details class="offer-line-details">
                                                            <summary>Détail</summary>
                                                            <p>{{ descriptionBody }}</p>
                                                        </details>
                                                    {% endif %}
                                                    {% if productUrl %}
                                                        <a class="offer-line-source" href="{{ productUrl }}" target="_blank" rel="noopener noreferrer">Fiche fournisseur</a>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="offer-line-figures">
                                                <div class="offer-line-qty-field">
                                                    <label class="offer-line-figure-label" for="line-qty-{{ proposal.id }}">Quantité</label>
                                                    <input type="number" class="form-control form-control-sm offer-line-qty"
                                                           id="line-qty-{{ proposal.id }}"
                                                           data-proposal-id="{{ proposal.id }}"
                                                           form="accept-offer-form"
                                                           value="{{ quantity }}"
                                                           min="1" max="10000" step="1" required
                                                           inputmode="numeric">
                                                </div>
                                                <div>
                                                    <span class="offer-line-figure-label">Prix unitaire</span>
                                                    <span class="offer-line-figure-value">
                                                        {% if unitMga is not null %}
                                                            {{ unitMga|number_format(0, ',', ' ') }} MGA
                                                        {% elseif unitRmb is not null %}
                                                            {{ unitRmb|number_format(2, ',', ' ') }} RMB
                                                        {% else %}
                                                            Non défini
                                                        {% endif %}
                                                    </span>
                                                </div>
                                                <div>
                                                    <span class="offer-line-figure-label">Montant</span>
                                                    <span class="offer-line-figure-value offer-line-amount">
                                                        {% if lineMga is not null %}
                                                            {{ lineMga|number_format(0, ',', ' ') }} MGA
                                                        {% elseif unitRmb is not null %}
                                                            {{ (unitRmb * quantity)|number_format(2, ',', ' ') }} RMB
                                                        {% else %}
                                                            —
                                                        {% endif %}
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                                <div class="offer-total-mobile">
                                    <span class="fw-bold">Total</span>
                                    <strong class="text-primary offer-total">
                                        {% if offer.rmbMgaExchangeRate %}
                                            {{ totalMga|number_format(0, ',', ' ') }} MGA
                                        {% else %}
                                            {{ totalRmb|number_format(2, ',', ' ') }} RMB
                                        {% endif %}
                                    </strong>
                                </div>
                            </div>
                            <div class="col-md-4 offer-recap">
                                <div class="bg-light rounded p-3">
                                    <h6 class="text-primary mb-3">
                                        <i class="fas fa-calculator me-2"></i>
                                        Récapitulatif
                                    </h6>
                                    <div class="fw-bold">Total</div>
                                    <strong class="text-primary fs-5 offer-total" id="offer-total">
                                        {% if offer.rmbMgaExchangeRate %}
                                            {{ totalMga|number_format(0, ',', ' ') }} MGA
                                        {% else %}
                                            {{ totalRmb|number_format(2, ',', ' ') }} RMB
                                        {% endif %}
                                    </strong>
                                    <p class="text-muted small mb-0 mt-2">Hors frais d'expédition. Le total suit les lignes cochées et les quantités saisies, au taux du devis{% if offer.rmbMgaExchangeRate %} ({{ offer.rmbMgaExchangeRate|number_format(2, ',', ' ') }}){% endif %}.</p>
                                </div>
                                
                                <!-- PDF de l'offre -->
                                <div class="mt-3">
                                    <button type="button"
                                            id="download-offer-pdf"
                                            class="btn btn-outline-primary w-100"
                                            data-url="{{ path('app_tracking_respond_pdf', {token: trackingToken}) }}">
                                        <i class="fas fa-file-pdf me-2"></i>
                                        Télécharger l'offre PDF
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Aucune offre disponible pour ce devis.
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Instructions -->
            <div class="alert alert-info">
                <h6 class="alert-heading">
                    <i class="fas fa-info-circle me-2"></i>
                    Instructions
                </h6>
                <p class="mb-2">Veuillez examiner attentivement cette offre avant de prendre votre décision :</p>
                <ul class="mb-0">
                    <li><strong>Accepter :</strong> Cochez les lignes à commander, ajustez les quantités, puis confirmez. Seul ce choix est enregistré.</li>
                    <li><strong>Refuser :</strong> Notre équipe vous proposera une nouvelle offre adaptée à vos besoins</li>
                </ul>
            </div>

            <!-- Boutons d'action -->
            <div class="action-buttons">
                <div class="d-flex gap-3 justify-content-center">
                    <form method="post" id="accept-offer-form" action="{{ path('app_tracking_accept', {'token': trackingToken}) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('accept' ~ offer.id) }}">
                        {% for proposal in offer.productProposals %}
                            <input type="hidden" name="lines[{{ proposal.id }}][quantity]" id="line-qty-posted-{{ proposal.id }}" value="{{ proposal.quoteItem.quantity ?: 1 }}">
                        {% endfor %}
                        <button type="submit" id="accept-offer-button" class="btn btn-success btn-lg px-5">
                            <i class="fas fa-check me-2"></i>
                            Accepter l'offre
                        </button>
                    </form>
                    
                    <form method="post" action="{{ path('app_tracking_decline', {'token': trackingToken}) }}" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-lg px-5"
                                onclick="return confirm('Êtes-vous sûr de vouloir refuser cette offre ? Notre équipe vous proposera une nouvelle offre.')">
                            <i class="fas fa-times me-2"></i>
                            Refuser l'offre
                        </button>
                    </form>
                </div>
                
                <div class="text-center mt-3">
                    <small class="text-muted">
                        <i class="fas fa-shield-alt me-1"></i>
                        Vos données sont sécurisées et votre réponse sera transmise immédiatement à notre équipe.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const lines = document.querySelectorAll('.offer-line');
            const totalEls = document.querySelectorAll('.offer-total');
            const acceptForm = document.getElementById('accept-offer-form');
            const acceptButton = document.getElementById('accept-offer-button');
            const hasRate = lines.length > 0 && lines[0].dataset.rate !== '';

            function formatNumber(value, digits) {
                return value.toLocaleString('fr-FR', {
                    minimumFractionDigits: digits,
                    maximumFractionDigits: digits
                });
            }

            function selectedCount() {
                return document.querySelectorAll('.offer-line-selected:checked').length;
            }

            function writePostedQuantity(qtyInput) {
                const hidden = document.getElementById('line-qty-posted-' + qtyInput.dataset.proposalId);
                if (hidden) {
                    hidden.value = qtyInput.value;
                }
            }

            function syncQuantities() {
                document.querySelectorAll('.offer-line-qty').forEach(function(qtyInput) {
                    let qty = parseInt(qtyInput.value, 10);
                    if (!Number.isFinite(qty) || qty < 1) {
                        qty = 1;
                    } else if (qty > 10000) {
                        qty = 10000;
                    }
                    qtyInput.value = String(qty);
                    writePostedQuantity(qtyInput);
                });
                recalc();
            }

            function recalc() {
                let totalMga = 0;
                let totalRmb = 0;
                lines.forEach(function(line) {
                    const checked = line.querySelector('.offer-line-selected').checked;
                    const qtyInput = line.querySelector('.offer-line-qty');
                    let qty = parseInt(qtyInput.value, 10);
                    if (!Number.isFinite(qty) || qty < 1) {
                        qty = 1;
                    }
                    if (qty > 10000) {
                        qty = 10000;
                    }
                    const unitRmb = Number(line.dataset.unitRmb);
                    const rate = Number(line.dataset.rate);
                    const amountEl = line.querySelector('.offer-line-amount');
                    line.classList.toggle('opacity-50', !checked);
                    if (!checked) {
                        amountEl.textContent = 'Non incluse';
                        return;
                    }
                    if (Number.isFinite(rate) && rate > 0 && Number.isFinite(unitRmb)) {
                        const lineMga = Math.round(unitRmb * rate * qty);
                        totalMga += lineMga;
                        amountEl.textContent = formatNumber(lineMga, 0) + ' MGA';
                    } else if (Number.isFinite(unitRmb)) {
                        const lineRmb = unitRmb * qty;
                        totalRmb += lineRmb;
                        amountEl.textContent = formatNumber(lineRmb, 2) + ' RMB';
                    }
                });
                const totalText = hasRate
                    ? formatNumber(totalMga, 0) + ' MGA'
                    : formatNumber(totalRmb, 2) + ' RMB';
                totalEls.forEach(function(totalEl) {
                    totalEl.textContent = totalText;
                });
                if (acceptButton) {
                    acceptButton.disabled = selectedCount() === 0;
                }
            }

            lines.forEach(function(line) {
                line.querySelector('.offer-line-selected').addEventListener('change', recalc);
                const qtyInput = line.querySelector('.offer-line-qty');
                qtyInput.addEventListener('input', function() {
                    writePostedQuantity(qtyInput);
                    recalc();
                });
                qtyInput.addEventListener('change', function() {
                    let qty = parseInt(qtyInput.value, 10);
                    if (!Number.isFinite(qty) || qty < 1) {
                        qtyInput.value = '1';
                    } else if (qty > 10000) {
                        qtyInput.value = '10000';
                    }
                    writePostedQuantity(qtyInput);
                    recalc();
                });
            });
            recalc();

            const pdfButton = document.getElementById('download-offer-pdf');
            if (pdfButton && acceptForm) {
                pdfButton.addEventListener('click', function() {
                    if (selectedCount() === 0) {
                        window.alert('Sélectionnez au moins une ligne.');
                        return;
                    }
                    syncQuantities();
                    pdfButton.disabled = true;
                    fetch(pdfButton.dataset.url, {
                        method: 'POST',
                        body: new FormData(acceptForm),
                        credentials: 'same-origin'
                    }).then(function(response) {
                        const type = response.headers.get('Content-Type') || '';
                        if (!response.ok || type.indexOf('pdf') === -1) {
                            throw new Error('pdf');
                        }
                        const match = /filename="([^"]+)"/.exec(response.headers.get('Content-Disposition') || '');
                        return response.blob().then(function(blob) {
                            return { blob: blob, name: match ? match[1] : 'offre.pdf' };
                        });
                    }).then(function(file) {
                        const url = URL.createObjectURL(file.blob);
                        const link = document.createElement('a');
                        link.href = url;
                        link.download = file.name;
                        link.click();
                        URL.revokeObjectURL(url);
                    }).catch(function() {
                        window.alert('Le PDF n\'a pas pu être généré.');
                    }).finally(function() {
                        pdfButton.disabled = false;
                    });
                });
            }

            if (acceptForm) {
                acceptForm.addEventListener('submit', function(event) {
                    syncQuantities();
                    if (selectedCount() === 0) {
                        event.preventDefault();
                        window.alert('Sélectionnez au moins une ligne.');
                        return;
                    }
                    const total = totalEls.length ? totalEls[0].textContent : '';
                    if (!window.confirm('Accepter cette offre pour ' + total + ' ? Les quantités et les lignes choisies seront enregistrées. Cette action est définitive.')) {
                        event.preventDefault();
                        return;
                    }
                    acceptButton.disabled = true;
                    acceptButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Traitement...';
                });
            }

            const declineForm = document.querySelector('form[action*="/decline"]');
            if (declineForm) {
                declineForm.addEventListener('submit', function() {
                    const button = declineForm.querySelector('button[type="submit"]');
                    button.disabled = true;
                    button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Traitement...';
                });
            }
        });
    </script>
{% endblock %}
